FROM alpine:edge

RUN apk add --no-cache \
    iptables \
    iproute2 \
    apache2-utils \
    hping3 --repository=http://dl-cdn.alpinelinux.org/alpine/edge/testing \
    netcat-openbsd \
    iputils \
    bind-tools \
    wget \
    curl \
    nmap \
    python3 \
    procps

CMD ["sh", "-c", "python3 -m http.server 80 & tail -f /dev/null"]
